# Django environment settings for production
# Generate a fresh key, e.g.: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=generate-a-new-50-char-secret-key
DJANGO_SETTINGS_MODULE=config.settings.production
# Comma-separated list of the real production host(s).
DJANGO_ALLOWED_HOSTS=api.example.com

# CORS (comma-separated), e.g. your deployed frontend origin(s).
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com

# Google OAuth2 settings
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_SECRET=your-google-secret
